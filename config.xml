<widget xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android" id="com.foodzy.customerapp" version="1.0.2">
<name>Foodzy</name>
<description>Foodzy — Food in minutes. Quick-commerce grocery delivery app.</description>
<author email="dev@foodzy.app" href="https://foodzy.app">Foodzy Team</author>
<!--  Entry point: must match your file in www/ (Foodzy's app file, renamed to index.html)  -->
<content src="index.html"/>
<!--  Network + external-link access  -->
<access origin="*"/>
<allow-intent href="http://*/*"/>
<allow-intent href="https://*/*"/>
<allow-intent href="tel:*"/>
<allow-intent href="sms:*"/>
<allow-intent href="mailto:*"/>
<allow-intent href="geo:*"/>
<!--  App icon (falls back to this for any density not explicitly declared below)  -->
<icon src="www/icons/icon-512.png"/>
<!--  ===== General Preferences =====  -->
<preference name="Orientation" value="portrait"/>
<preference name="Fullscreen" value="false"/>
<preference name="AndroidXEnabled" value="true"/>
<preference name="DisallowOverscroll" value="true"/>
<!--  Foodzy handles its own internal scrolling in JS/CSS, so the native
         WebView page-scroll (and its rubber-band bounce) is turned off.  -->
<preference name="ScrollEnabled" value="false"/>
<preference name="BackupWebStorage" value="none"/>
<!--  Splash screen  -->
<preference name="SplashMaintainAspectRatio" value="true"/>
<preference name="FadeSplashScreenDuration" value="300"/>
<preference name="SplashShowOnlyFirstTime" value="false"/>
<preference name="SplashScreen" value="screen"/>
<preference name="SplashScreenDelay" value="3000"/>
<!--  Keep these current with Google Play's latest required API levels
         before you publish — check the Play Console "Target API level"
         requirement page, these numbers can change year to year.  -->
<preference name="android-minSdkVersion" value="24"/>
<preference name="android-targetSdkVersion" value="36"/>
<!--  Play Console checks THIS number (not the version= above) to allow
         a new upload. Bump it by at least 1 every single time you build a
         new AAB for Play Console — even if "version" above doesn't change.  -->
<preference name="android-versionCode" value="3"/>
<!--  ===== Geolocation Plugin =====
         This is what makes navigator.geolocation.getCurrentPosition() in
         Foodzy's JS trigger Android's native "Allow Foodzy to access this
         device's location?" permission dialog.  -->
<plugin name="cordova-plugin-geolocation" spec="~4.1.0">
<variable name="GPS_REQUIRED" value="true"/>
</plugin>
<!--  ===== OneSignal Push Notifications Plugin =====
         Provides window.plugins.OneSignal in the app's JS. Also auto-injects
         the Android notification permission (below) and FCM setup needed
         for push to work. See the setup steps Foodzy gave you for the
         OneSignal dashboard + Firebase side of this.  -->
<plugin name="onesignal-cordova-plugin" spec="^5.0.0"/>
 <plugin name="cordova-plugin-diagnostic" spec="^7.0.0" />        
<!--  ===== Android Platform =====  -->
<platform name="android">
         <resource-file src="google-services.json" target="app/google-services.json" />
<allow-intent href="market:*"/>
<!--  Injected into AndroidManifest.xml on every build  -->
<config-file target="AndroidManifest.xml" parent="/*">
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS"/>
<!--  Required on Android 13+ (API 33+) for the notification
                 permission prompt to appear at all — without this, push
                 notifications are silently blocked on newer phones.  -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
</config-file>
<!--  App icon per density (optional — uses the top-level <icon> above
             as a fallback for any size you don't provide). Add more of your
             own generated sizes here if you have them: ldpi, mdpi, hdpi,
             xhdpi, xxhdpi, xxxhdpi.  -->
<icon src="icons/icon-512.png" density="xxxhdpi"/>
<icon src="icons/icon-192.png" density="mdpi"/>
</platform>
</widget>
